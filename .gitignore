# ============================================
# DATA — never commit (regenerable, large, may contain pre-computed snapshots)
# ============================================
data/
*.RDS
*.rds

# ============================================
# TOOLING — track .R / .sh source, ignore noise
# ============================================
# (R/ and scripts/ used to be ignored entirely; selectively re-enabled
# 2026-05-08 so the data pipeline + migration scripts are version-controlled.)
R/testy.Rmd
R/testy.nb.html
R/.Rhistory
scripts/update.log

# ============================================
# QUARTO — build artifacts
# ============================================
# _site/ IS committed (Netlify publishes from git). Do not ignore it.
_freeze/
.quarto/
**/*.quarto_ipynb

